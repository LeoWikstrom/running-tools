{
  "name": "runtour",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "dev": "vite --host 0.0.0.0",
    "dev:bus": "vite --host 0.0.0.0 --port 5174 --mode bus",
    "build": "tsc && vite build && vite build --mode bus --outDir dist-bus",
    "lint": "eslint src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@running/core": "0.1.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/leaflet": "^1.9.22",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
